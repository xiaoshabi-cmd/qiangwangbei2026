n = f.degree()

def F0():
    D = DiscreteGaussianDistributionIntegerSampler(sigma=3.371)
    s = PR([D() for _ in range(n)])
    e = PR([D() for _ in range(n)])
    a = PR([randbelow(p) for _ in range(n)])
    b = (a*s + e) % f
    return [a.list(), b.list()]

def F1():
    a = PR([randbelow(p) for _ in range(n)])
    b = PR([randbelow(p) for _ in range(n)])
    return [a.list(), b.list()]

with open("samples.txt", "w") as s:
    s.write("output =" + str([F0() if i == "0" else F1() for i in bin(bytes_to_long(flag))[2:].zfill(len(flag)*8)]))